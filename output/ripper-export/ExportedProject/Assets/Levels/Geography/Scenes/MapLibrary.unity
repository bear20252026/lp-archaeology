  m_Name:
  m_EditorClassIdentifier:
  prompt: 交谈
  keyLabel: E
  radius: 1.3
  focusPoint: {fileID: 1240}
  requireFacing: 1
  maxFacingAngle: 100
  requireSide: 1
  sideHalfAngle: 75
  priority: 1
  interactable: 1
  usableWhileCarrying: 0
  holdSeconds: 0
  promptAnchor: {fileID: 0}
  promptHeight: 0.6
  onInteract:
    m_PersistentCalls:
      m_Calls: []
  animator: {fileID: 3335}
  clipData: {fileID: 11400000, guid: 4b8d0f7be7fc8534894047a27895f942, type: 2}
  subtitles: {fileID: 3442}
  lines:
  - speaker: 地理学家
    text: 瞧！来了一位探险家！
  - speaker: 地理学家
    text: 你从远方来！给我讲讲你的星球！
  - speaker: 小王子
    text: 我那儿很小。我有三座火山。
  - speaker: 小王子
    text: 我还有一朵花。
  - speaker: 地理学家
    text: 我们不记录花。
  - speaker: 小王子
    text: 为什么！花是最美的！
  - speaker: 地理学家
    text: 因为花是转瞬即逝的。
  - speaker: 小王子
    text: “转瞬即逝”是什么意思？
  - speaker: 地理学家
    text: 意思是“很快就有消失的危险”。
  - speaker: 小王子（自语）
    text: 我的花是转瞬即逝的，她只有四根刺来保护自己！而我把她独自留在了家里！
  minLineSeconds: 2.5
  secondsPerCharacter: 0.35
  gapSeconds: 0.3
  pickWriteDelay: 0.5
  backToBookDelay: 1
  backToBookCrossfade: 0.25
  stunnedBeat: 1
  completeDelay: 1
  restWaitMax: 0.6
  restBlend: 0.1
  offRestBlend: 0.25
  replayable: 0
